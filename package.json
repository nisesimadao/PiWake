{
  "name": "piwake",
  "private": true,
  "version": "1.0.0",
  "description": "Self-hosted Raspberry Pi Wake-on-LAN dashboard with Tailscale-first remote access, scheduling, monitoring and Discord controls.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nisesimadao/PiWake.git"
  },
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "server": "node server/index.js",
    "start": "npm run build && node server/index.js",
    "test": "node --test \"server/test/*.test.js\""
  },
  "dependencies": {
    "@fortawesome/free-brands-svg-icons": "^7.3.0",
    "@vitejs/plugin-react": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "typescript": "latest",
    "vite": "latest"
  }
}
